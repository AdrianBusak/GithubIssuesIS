@page "/login"

<main class="page-shell">
    <div class="page-header">
        <h1>Login</h1>
    </div>
    <section class="panel">
        <div class="form-grid">
            <div class="form-row">
                <label for="username">Username</label>
                <input id="username" />
            </div>
            <div class="form-row">
                <label for="password">Password</label>
                <input id="password" type="password" />
            </div>
            <div class="actions">
                <button type="button" disabled>Login</button>
            </div>
        </div>
    </section>
</main>
