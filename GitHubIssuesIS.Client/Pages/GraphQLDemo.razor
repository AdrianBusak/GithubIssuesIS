@page "/graphql"
@inject GraphQLClient GraphQLClient

<main class="page-shell">
    <div class="page-header">
        <h1>GraphQL</h1>
    </div>
    <section class="panel">
        <div class="form-grid graphql-form">
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <p class="error">@error</p>
            }

            <div class="form-row">
                <label for="graphql-query">Query</label>
                <textarea id="graphql-query" class="code-input" @bind="query"></textarea>
            </div>

            <div class="actions">
                <button type="button" @onclick="ExecuteAsync" disabled="@executing">
                    @(executing ? "Executing..." : "Execute")
                </button>
            </div>

            <div class="form-row">
                <label for="graphql-response">Response</label>
                <pre id="graphql-response" class="code-output">@response</pre>
            </div>
        </div>
    </section>
</main>

@code {
    private string query =
        "query {\n" +
        "  issues {\n" +
        "    number\n" +
        "    title\n" +
        "    state\n" +
        "  }\n" +
        "}";

    private string? response;
    private string? error;
    private bool executing;

    private async Task ExecuteAsync()
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            error = "Query is required.";
            return;
        }

        executing = true;
        error = null;
        response = null;

        try
        {
            response = await GraphQLClient.ExecuteAsync(query);
        }
        catch (UnauthorizedAccessException)
        {
            error = "Login is required.";
        }
        catch (HttpRequestException ex)
        {
            error = string.IsNullOrWhiteSpace(ex.Message)
                ? "GraphQL request failed."
                : ex.Message;
        }
        finally
        {
            executing = false;
        }
    }
}
