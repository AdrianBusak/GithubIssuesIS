@page "/register"
@inject AuthClient AuthClient
@inject NavigationManager NavigationManager

<main class="page-shell">
    <div class="page-header">
        <h1>Register</h1>
    </div>
    <section class="panel">
        <EditForm Model="@registerRequest" OnValidSubmit="RegisterAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <p class="error">@error</p>
            }

            <div class="form-grid">
                <div class="form-row">
                    <label for="username">Username</label>
                    <InputText id="username" @bind-Value="registerRequest.Username" />
                    <ValidationMessage For="() => registerRequest.Username" />
                </div>
                <div class="form-row">
                    <label for="password">Password</label>
                    <InputText id="password" type="password" @bind-Value="registerRequest.Password" />
                    <ValidationMessage For="() => registerRequest.Password" />
                </div>
                <div class="actions">
                    <button type="submit" disabled="@submitting">
                        @(submitting ? "Creating account..." : "Register")
                    </button>
                    <a class="button secondary" href="/login">Back to login</a>
                </div>
            </div>
        </EditForm>
    </section>
</main>

@code {
    private readonly LoginRequestDto registerRequest = new();
    private bool submitting;
    private string? error;

    private async Task RegisterAsync()
    {
        submitting = true;
        error = null;

        try
        {
            var authenticated = await AuthClient.RegisterAsync(registerRequest);

            if (!authenticated)
            {
                error = "Register failed. Username may already be taken.";
                return;
            }

            NavigationManager.NavigateTo("/issues");
        }
        catch (HttpRequestException)
        {
            error = "API request failed.";
        }
        finally
        {
            submitting = false;
        }
    }
}
