@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService AuthState
@inject AuthClient AuthClient
@inject NavigationManager NavigationManager

<div class="app-frame">
    <aside class="sidebar">
        <a class="brand" href="/issues">GitHubIssuesIS</a>
        <nav>
            <NavLink href="/issues" Match="NavLinkMatch.Prefix">Issues</NavLink>
            @if (AuthState.IsAdmin)
            {
                <NavLink href="/import">Import</NavLink>
            }
            <NavLink href="/soap-search">SOAP</NavLink>
            <NavLink href="/weather">Weather</NavLink>
            <NavLink href="/graphql">GraphQL</NavLink>
        </nav>
    </aside>
    <div class="main-area">
        <header class="topbar">
            <div class="topbar-auth">
                @if (AuthState.IsAuthenticated)
                {
                    <span class="user-badge">@AuthState.Username</span>
                    <span class="role-badge">@AuthState.Role</span>
                    <button type="button" class="secondary" @onclick="SignOutAsync">Sign out</button>
                }
                else
                {
                    <a class="button" href="/login">Login</a>
                    <a class="button secondary" href="/register">Register</a>
                }
            </div>
        </header>
        <div class="content">
            @Body
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthState.Changed += OnAuthStateChanged;
    }

    private async Task SignOutAsync()
    {
        await AuthClient.SignOutAsync();
        NavigationManager.NavigateTo("/login", replace: true);
    }

    private void OnAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthState.Changed -= OnAuthStateChanged;
    }
}
